{
  "name": "@woodylovesboota/test-kit",
  "version": "0.3.0",
  "description": "Jest and Playwright presets, result reporters, and one offline HTML report for both.",
  "keywords": [
    "jest",
    "playwright",
    "test-report",
    "reporter",
    "html-report"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WoodyLovesBoota/test-kit.git"
  },
  "homepage": "https://github.com/WoodyLovesBoota/test-kit#readme",
  "bugs": {
    "url": "https://github.com/WoodyLovesBoota/test-kit/issues"
  },
  "type": "module",
  "bin": {
    "testkit": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/presets/jest.d.ts",
        "default": "./dist/presets/jest.js"
      },
      "require": {
        "types": "./dist/presets/jest.d.cts",
        "default": "./dist/presets/jest.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/presets/playwright.d.ts",
        "default": "./dist/presets/playwright.js"
      },
      "require": {
        "types": "./dist/presets/playwright.d.cts",
        "default": "./dist/presets/playwright.cjs"
      }
    },
    "./reporters/jest": {
      "import": {
        "types": "./dist/reporters/jest.d.ts",
        "default": "./dist/reporters/jest.js"
      },
      "require": {
        "types": "./dist/reporters/jest.d.cts",
        "default": "./dist/reporters/jest.cjs"
      }
    },
    "./reporters/playwright": {
      "import": {
        "types": "./dist/reporters/playwright.d.ts",
        "default": "./dist/reporters/playwright.js"
      },
      "require": {
        "types": "./dist/reporters/playwright.d.cts",
        "default": "./dist/reporters/playwright.cjs"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/helpers/playwright.d.ts",
        "default": "./dist/helpers/playwright.js"
      },
      "require": {
        "types": "./dist/helpers/playwright.d.cts",
        "default": "./dist/helpers/playwright.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "jest": ">=29.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "jest": "^30.5.2",
    "tsup": "^9.0.0",
    "typescript": "^5"
  }
}
